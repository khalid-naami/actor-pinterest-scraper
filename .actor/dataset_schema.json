{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": true,
        "properties": {
            "type": {
                "type": "string",
                "title": "Entity Type"
            },
            "url": {
                "type": "string",
                "title": "Pinterest URL"
            },
            "id": {
                "type": "string",
                "title": "Pin ID, Board ID, or Username"
            },
            "title": {
                "type": "string",
                "title": "Pin Title / Board Name"
            },
            "description": {
                "type": "string",
                "title": "Pin / Board / Profile Description"
            },
            "imageUrl": {
                "type": "string",
                "title": "Original HD Image URL"
            },
            "coverUrl": {
                "type": "string",
                "title": "Board Cover Image URL"
            },
            "images": {
                "type": "object",
                "title": "All Image Resolutions",
                "additionalProperties": true
            },
            "isVideo": {
                "type": "boolean",
                "title": "Is Video Pin"
            },
            "videoUrl": {
                "type": "string",
                "title": "Direct MP4 Video Download Link"
            },
            "outboundUrl": {
                "type": "string",
                "title": "Outbound Store / Website Link"
            },
            "domain": {
                "type": "string",
                "title": "Outbound Domain (Shopify, Etsy, etc.)"
            },
            "saveCount": {
                "type": "integer",
                "title": "Saves / Repins Count"
            },
            "commentsCount": {
                "type": "integer",
                "title": "Comments Count"
            },
            "author": {
                "type": "string",
                "title": "Creator Username"
            },
            "authorName": {
                "type": "string",
                "title": "Creator Display Name"
            },
            "authorUrl": {
                "type": "string",
                "title": "Creator Profile URL"
            },
            "authorAvatarUrl": {
                "type": "string",
                "title": "Creator Avatar URL"
            },
            "authorFollowers": {
                "type": "integer",
                "title": "Creator Followers Count"
            },
            "authorMonthlyViews": {
                "type": "string",
                "title": "Creator Monthly Views"
            },
            "boardName": {
                "type": "string",
                "title": "Board Name"
            },
            "boardUrl": {
                "type": "string",
                "title": "Board URL"
            },
            "boardPinsCount": {
                "type": "integer",
                "title": "Board Pins Count"
            },
            "price": {
                "type": "string",
                "title": "Product Price"
            },
            "currency": {
                "type": "string",
                "title": "Price Currency"
            },
            "hashtags": {
                "type": "array",
                "title": "Hashtags List",
                "items": {
                    "type": "string"
                }
            },
            "email": {
                "type": "string",
                "title": "Contact Email"
            },
            "emails": {
                "type": "array",
                "title": "Extracted Emails",
                "items": {
                    "type": "string"
                }
            },
            "phones": {
                "type": "array",
                "title": "Extracted Phones",
                "items": {
                    "type": "string"
                }
            },
            "searchQuery": {
                "type": "string",
                "title": "Search Keyword"
            },
            "createdAt": {
                "type": "string",
                "title": "Creation Timestamp"
            },
            "scrapedAt": {
                "type": "string",
                "title": "Scraped At Timestamp"
            }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "type",
                    "title",
                    "authorName",
                    "saveCount",
                    "domain",
                    "outboundUrl",
                    "url"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "type": {
                        "label": "Type",
                        "format": "text"
                    },
                    "title": {
                        "label": "Title",
                        "format": "text"
                    },
                    "authorName": {
                        "label": "Creator",
                        "format": "text"
                    },
                    "saveCount": {
                        "label": "Saves",
                        "format": "number"
                    },
                    "domain": {
                        "label": "Domain",
                        "format": "text"
                    },
                    "outboundUrl": {
                        "label": "Outbound Link",
                        "format": "link"
                    },
                    "url": {
                        "label": "Pinterest URL",
                        "format": "link"
                    }
                }
            }
        }
    }
}
